---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/ui/Icon.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import ErrorBanner from '../components/ui/ErrorBanner.astro';
import Button from '../components/ui/Button.astro';
import DataTable from '../components/ui/DataTable.astro';
import ClockDoodle from '../components/doodles/ClockDoodle.astro';
import ScheduleRow from '../components/schedules/ScheduleRow.astro';
import ScheduleSidebar from '../components/schedules/ScheduleSidebar.astro';
import ScheduleNewForm from '../components/schedules/ScheduleNewForm.astro';
import search from 'lucide-static/icons/search.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
import { gql } from '../lib/graphql';
import { currentRole, canAction, Action } from '../lib/permissions';
import { clientApiUrl } from '../lib/api';

interface ScheduleNode {
  id: string;
  name: string;
  description: string;
  agentName: string;
  cronExpression: string;
  executionsCount: number;
  lastRunAt: string | null;
  nextRunAt: string | null;
  status: string;
  prompt: string;
  failureHandling: string;
  targetEndUserExternalId: string;
}

interface AgentNode {
  id: string;
  name: string;
}

interface EndUserNode {
  id: string;
  externalUserId: string;
}

interface SchedulesPageData {
  schedules: { edges: { node: ScheduleNode }[] };
  agents: { edges: { node: AgentNode }[] };
  endUsers: { edges: { node: EndUserNode }[] };
}

const cookie = Astro.request.headers.get('cookie') ?? '';
const wsSlug = Astro.locals.workspaceSlug ?? undefined;
const apiUrl = clientApiUrl;

const { data, errors } = await gql<SchedulesPageData>(
  `query SchedulesPage {
    schedules(first: 100) {
      edges { node {
        id name description agentName cronExpression
        executionsCount lastRunAt nextRunAt status
        prompt failureHandling targetEndUserExternalId
      } }
    }
    agents(first: 100) {
      edges { node { id name } }
    }
    endUsers(first: 100) {
      edges { node { id externalUserId } }
    }
  }`,
  {},
  cookie,
  wsSlug,
);

const schedules = data?.schedules?.edges?.map((e) => e.node) ?? [];
const agents = data?.agents?.edges?.map((e) => e.node) ?? [];
const endUsers = data?.endUsers?.edges?.map((e) => e.node) ?? [];
const hasError = !!errors;
const role = currentRole(Astro.locals.workspaces, Astro.locals.workspaceSlug);
const canWrite = canAction(role, Action.SCHEDULES_WRITE);
const isNew = Astro.locals.layout === 'new';
---

<DashboardLayout title="Schedules · midsphere" current="schedules">
  <div id="api-config" data-url={apiUrl} data-ws={wsSlug ?? ''} hidden></div>

  {hasError && <ErrorBanner message={errors![0]?.message} />}

  {
    !hasError && schedules.length === 0 && (
      <EmptyState
        heading="No schedules yet"
        body='Set a frequency and <span class="hl">let it run on its own</span> — digests, monitoring, daily prep.'
      >
        <ClockDoodle size={64} slot="doodle" />
        {canWrite && (
          <Button variant="accent" id="new-schedule-empty">
            <Icon svg={plus} size={16} />
            Create schedule
          </Button>
        )}
      </EmptyState>
    )
  }

  {
    !hasError && schedules.length > 0 && (
      <div class="schedules-layout">
        <div class="schedules-main">
          <div class:list={['schedules-header', isNew && 'p-5 card']}>
            <div>
              <h1
                class:list={[
                  isNew ? 'text-2xl' : 'text-xl',
                  'font-semibold tracking-tight text-fg-1',
                ]}
              >
                <span class="hl">Schedules</span>
              </h1>
              <p class="schedules-subtitle">Agents that run on their own</p>
            </div>
            {canWrite && (
              <Button variant="accent" id="new-schedule-btn">
                <Icon svg={plus} size={16} />
                New schedule
              </Button>
            )}
          </div>

          <div class="schedules-toolbar">
            <form role="search" class="schedules-search">
              <Icon svg={search} size={16} class="search-icon" />
              <input
                type="search"
                id="schedule-search"
                aria-label="Search schedules"
                placeholder="Search schedules..."
                class="search-input"
                autocomplete="off"
              />
            </form>

            <div class="filter-pills" role="radiogroup" aria-label="Filter schedules by status">
              <button
                type="button"
                class="pill pill-active"
                role="radio"
                aria-checked="true"
                data-filter="all"
              >
                All
              </button>
              <button
                type="button"
                class="pill"
                role="radio"
                aria-checked="false"
                data-filter="active"
              >
                Active
              </button>
              <button
                type="button"
                class="pill"
                role="radio"
                aria-checked="false"
                data-filter="paused"
              >
                Paused
              </button>
            </div>
          </div>

          <DataTable label="Schedules" class={isNew ? 'card p-2' : ''}>
            <tr slot="head">
              <th>Schedule</th>
              <th>Frequency</th>
              <th>Triggers</th>
              <th>Last run</th>
              <th>Next run</th>
              <th>Status</th>
            </tr>
            {schedules.map((s) => (
              <ScheduleRow
                id={s.id}
                name={s.name}
                description={s.description}
                agentName={s.agentName}
                cronExpression={s.cronExpression}
                executionsCount={s.executionsCount}
                lastRunAt={s.lastRunAt}
                nextRunAt={s.nextRunAt}
                status={s.status}
                prompt={s.prompt}
                failureHandling={s.failureHandling}
                targetEndUserExternalId={s.targetEndUserExternalId}
              />
            ))}
          </DataTable>

          <p class="item-count" id="schedule-count" aria-live="polite" aria-atomic="true">
            Showing {schedules.length} of {schedules.length} schedules
          </p>
        </div>

        <ScheduleSidebar schedules={schedules} />
      </div>
    )
  }

  <div data-can-write={canWrite ? 'true' : 'false'}>
    <ScheduleNewForm agents={agents} endUsers={endUsers} />
  </div>
</DashboardLayout>

<style>
  .schedules-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ms-space-8);
    max-width: 1200px;
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .schedules-layout {
      grid-template-columns: 65fr 35fr;
    }
  }

  .schedules-main {
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-4);
  }

  .schedules-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--ms-space-4);
  }

  .schedules-subtitle {
    font-size: 0.875rem;
    color: var(--ms-fg-2);
    margin-top: 2px;
  }

  .schedules-toolbar {
    display: flex;
    align-items: center;
    gap: var(--ms-space-3);
    flex-wrap: wrap;
  }

  .schedules-search {
    flex: 1;
    min-width: 200px;
    position: relative;
    display: flex;
    align-items: center;
  }
</style>

<script is:inline src="/scripts/schedules.js"></script>

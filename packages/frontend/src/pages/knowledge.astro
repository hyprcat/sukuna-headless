---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Icon from '../components/ui/Icon.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import ErrorBanner from '../components/ui/ErrorBanner.astro';
import Button from '../components/ui/Button.astro';
import BookDoodle from '../components/doodles/BookDoodle.astro';
import KnowledgeCard from '../components/knowledge/KnowledgeCard.astro';
import KnowledgeDetail from '../components/knowledge/KnowledgeDetail.astro';
import KnowledgeNewForm from '../components/knowledge/KnowledgeNewForm.astro';
import search from 'lucide-static/icons/search.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
import { gql } from '../lib/graphql';
import { currentRole, canAction, Action } from '../lib/permissions';
import { clientApiUrl } from '../lib/api';

interface KnowledgeNode {
  id: string;
  name: string;
  description: string;
  kind: string;
  fileName: string;
  fileSizeBytes: number | null;
  contentType: string;
  sourceEndpoint: string;
  isActive: boolean;
  createdAt: string;
  updatedAt: string;
  lastIndexedAt: string | null;
}

interface AgentNode {
  id: string;
  name: string;
  knowledgeBases: { id: string }[];
}

interface KnowledgePageData {
  knowledgeBases: { edges: { node: KnowledgeNode }[] };
  agents: { edges: { node: AgentNode }[] };
}

const cookie = Astro.request.headers.get('cookie') ?? '';
const wsSlug = Astro.locals.workspaceSlug ?? undefined;
const apiUrl = clientApiUrl;

const { data, errors } = await gql<KnowledgePageData>(
  `query KnowledgePage {
    knowledgeBases(first: 100) {
      edges { node {
        id name description kind
        fileName fileSizeBytes contentType
        sourceEndpoint isActive
        createdAt updatedAt lastIndexedAt
      } }
    }
    agents(first: 100) {
      edges { node { id name knowledgeBases: knowledge { id } } }
    }
  }`,
  {},
  cookie,
  wsSlug,
);

const items = data?.knowledgeBases?.edges?.map((e) => e.node) ?? [];
const agents = data?.agents?.edges?.map((e) => e.node) ?? [];

const kbAgentMap = new Map<string, string[]>();
for (const agent of agents) {
  for (const kb of agent.knowledgeBases) {
    const existing = kbAgentMap.get(kb.id) ?? [];
    existing.push(agent.name);
    kbAgentMap.set(kb.id, existing);
  }
}

const hasError = !!errors;
const role = currentRole(Astro.locals.workspaces, Astro.locals.workspaceSlug);
const canWrite = canAction(role, Action.KNOWLEDGE_WRITE);
const layout = Astro.locals.layout;
---

<DashboardLayout title="Knowledge · midsphere" current="knowledge">
  <div id="api-config" data-url={apiUrl} data-ws={wsSlug ?? ''} hidden></div>

  {hasError && <ErrorBanner message={errors![0]?.message} />}

  {
    !hasError && (
      <div class="kb-layout">
        {layout === 'new' ? (
          <div class="flex flex-col gap-1">
            <h1 class="text-2xl font-semibold leading-tight tracking-tight text-fg-1">
              <span class="hl">Knowledge</span>
            </h1>
            <p class="text-sm text-fg-2">Documents, data, and context your agents can use</p>
          </div>
        ) : (
          <>
            <h1 class="text-xl font-semibold tracking-tight text-fg-1">
              <span class="hl">Knowledge</span>
            </h1>
            <p class="kb-subtitle">Documents, data, and context your agents can use</p>
          </>
        )}

        <div class="kb-toolbar">
          <form role="search" class="kb-search">
            <Icon svg={search} size={16} class="search-icon" />
            <input
              type="search"
              id="kb-search"
              aria-label="Search knowledge"
              placeholder="Search knowledge…"
              class="search-input"
              autocomplete="off"
            />
          </form>
          {canWrite && (
            <Button variant="accent" id="new-kb-btn">
              <Icon svg={plus} size={16} />
              Add knowledge
            </Button>
          )}
        </div>

        <div class="filter-pills" role="radiogroup" aria-label="Filter knowledge by status">
          <button
            type="button"
            class="pill pill-active"
            role="radio"
            aria-checked="true"
            data-filter="all"
          >
            All
          </button>
          <button type="button" class="pill" role="radio" aria-checked="false" data-filter="active">
            Active
          </button>
          <button
            type="button"
            class="pill"
            role="radio"
            aria-checked="false"
            data-filter="inactive"
          >
            Inactive
          </button>
        </div>

        {items.length === 0 ? (
          <EmptyState
            heading="No knowledge yet"
            body='Documents, data, and context your agents can <span class="hl">draw on</span>. Add a source to get started.'
          >
            <BookDoodle size={64} slot="doodle" />
            {canWrite && (
              <Button variant="accent" id="new-kb-empty">
                <Icon svg={plus} size={16} />
                Add knowledge
              </Button>
            )}
          </EmptyState>
        ) : (
          <>
            <div class="kb-grid" id="kb-grid">
              {items.map((kb) => (
                <KnowledgeCard
                  id={kb.id}
                  name={kb.name}
                  description={kb.description}
                  kind={kb.kind}
                  fileName={kb.fileName}
                  fileSizeBytes={kb.fileSizeBytes}
                  contentType={kb.contentType}
                  sourceEndpoint={kb.sourceEndpoint}
                  isActive={kb.isActive}
                  updatedAt={kb.updatedAt}
                  lastIndexedAt={kb.lastIndexedAt}
                  agents={kbAgentMap.get(kb.id) ?? []}
                />
              ))}
            </div>

            <p class="item-count" id="kb-count" aria-live="polite" aria-atomic="true">
              Showing {items.length} of {items.length} knowledge sources
            </p>
          </>
        )}

        <div data-can-write={canWrite ? 'true' : 'false'}>
          <KnowledgeDetail canWrite={canWrite} />
          {canWrite && <KnowledgeNewForm />}
        </div>

        <p class="kb-footer">Anyone on your team can add or update knowledge sources.</p>
      </div>
    )
  }
</DashboardLayout>

<style>
  .kb-layout {
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-4);
  }

  .kb-subtitle {
    font-size: 0.875rem;
    color: var(--ms-fg-2);
    margin-top: calc(-1 * var(--ms-space-2));
  }

  .kb-toolbar {
    display: flex;
    align-items: center;
    gap: var(--ms-space-3);
  }

  .kb-search {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
  }

  .kb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ms-space-3);
  }

  @media (min-width: 640px) {
    .kb-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .kb-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .kb-footer {
    font-size: 0.75rem;
    color: var(--ms-fg-3);
    text-align: center;
    padding-top: var(--ms-space-2);
  }
</style>

<script is:inline src="/scripts/knowledge.js"></script>

---
import AuthLayout from '../../../layouts/AuthLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
import ShieldDoodle from '../../../components/doodles/ShieldDoodle.astro';
import { apiPost } from '../../../lib/api';

const { uid, token } = Astro.params;

const { success, error } = await (async (): Promise<{ success: boolean; error: string }> => {
  if (Astro.request.method !== 'POST') return { success: false, error: '' };

  const form = await Astro.request.formData();
  const password = form.get('password')?.toString() ?? '';

  const result = await apiPost(
    '/auth/reset-password/',
    { uid, token, password },
    Astro.request.headers.get('cookie') ?? undefined,
  );

  if (result.ok) return { success: true, error: '' };
  return { success: false, error: result.error ?? 'Something went wrong.' };
})();
---

<AuthLayout title="New password · midsphere" description="Set a new password">
  <div class="relative">
    <ShieldDoodle
      size={120}
      class="doodle-float pointer-events-none absolute -right-4 -top-20 rotate-6"
    />

    <section
      class="relative rounded-lg border border-border-subtle bg-canvas p-8 shadow-1"
      aria-labelledby="reset-heading"
    >
      {
        success ? (
          <div>
            <h1 id="reset-heading" class="text-2xl font-medium tracking-tight">
              Password updated
            </h1>
            <p class="mt-3 text-sm text-fg-2 leading-relaxed">
              Your password has been changed. You can now sign in with your new password.
            </p>
            <div class="mt-7">
              <Button href="/login" variant="primary" full>
                Sign in
              </Button>
            </div>
          </div>
        ) : (
          <div>
            <h1 id="reset-heading" class="text-2xl font-medium tracking-tight">
              Set new password
            </h1>
            <p class="mt-2 text-sm text-fg-2">
              Choose a <span class="hl">strong password</span> you haven't used before.
            </p>

            {error && (
              <div class="mt-4 rounded-sm bg-err/10 px-4 py-3 text-sm text-err" role="alert">
                {error}
              </div>
            )}

            <form method="POST" class="mt-7 flex flex-col gap-5">
              <Input
                id="password"
                name="password"
                label="New password"
                type="password"
                placeholder="••••••••"
                autocomplete="new-password"
                required
                hint="At least 8 characters. Not too common, not too similar to your email."
              />
              <Button type="submit" variant="primary" full>
                Update password
              </Button>
            </form>
          </div>
        )
      }
    </section>
  </div>
</AuthLayout>

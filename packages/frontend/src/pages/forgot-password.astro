---
import AuthLayout from '../layouts/AuthLayout.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import ShieldDoodle from '../components/doodles/ShieldDoodle.astro';
import { apiPost } from '../lib/api';

const { sent, error } = await (async (): Promise<{ sent: boolean; error: string }> => {
  if (Astro.request.method !== 'POST') return { sent: false, error: '' };

  const form = await Astro.request.formData();
  const email = form.get('email')?.toString() ?? '';

  const result = await apiPost(
    '/auth/forgot-password/',
    { email },
    Astro.request.headers.get('cookie') ?? undefined,
  );

  if (result.ok) return { sent: true, error: '' };
  return { sent: false, error: result.error ?? 'Something went wrong.' };
})();
---

<AuthLayout title="Reset password · midsphere" description="Reset your midsphere password">
  <div class="relative">
    <ShieldDoodle
      size={120}
      class="doodle-float pointer-events-none absolute -right-4 -top-20 -rotate-6"
    />

    <section
      class="relative rounded-lg border border-border-subtle bg-canvas p-8 shadow-1"
      aria-labelledby="reset-heading"
    >
      {
        sent ? (
          <div>
            <h1 id="reset-heading" class="text-2xl font-medium tracking-tight">
              Check your email
            </h1>
            <p class="mt-3 text-sm text-fg-2 leading-relaxed">
              If an account with that email exists, we sent a reset link. It expires in one hour.
            </p>
            <div class="mt-7">
              <Button href="/login" variant="secondary" full>
                Back to sign in
              </Button>
            </div>
          </div>
        ) : (
          <div>
            <h1 id="reset-heading" class="text-2xl font-medium tracking-tight">
              Reset password
            </h1>
            <p class="mt-2 text-sm text-fg-2">
              Enter your email and we'll send a <span class="hl">reset link</span>.
            </p>

            {error && (
              <div class="mt-4 rounded-sm bg-err/10 px-4 py-3 text-sm text-err" role="alert">
                {error}
              </div>
            )}

            <form method="POST" class="mt-7 flex flex-col gap-5">
              <Input
                id="email"
                name="email"
                label="Email"
                type="email"
                placeholder="you@company.com"
                autocomplete="email"
                required
              />
              <Button type="submit" variant="primary" full>
                Send reset link
              </Button>
            </form>
          </div>
        )
      }
    </section>
  </div>

  <p class="mt-6 text-center text-sm text-fg-2">
    Remember your password?
    <a href="/login" class="text-fg-1 underline underline-offset-4">Sign in</a>
  </p>
</AuthLayout>

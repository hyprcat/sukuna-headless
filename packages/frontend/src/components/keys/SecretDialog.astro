---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import copy from 'lucide-static/icons/copy.svg?raw';
---

<dialog
  id="dlg-secret"
  aria-labelledby="dlg-secret-title"
  class="m-auto w-full max-w-lg rounded-xl bg-canvas p-0 shadow-lg backdrop:bg-black/40"
>
  <div class="p-6">
    <h2 id="dlg-secret-title" class="text-lg font-medium tracking-tight text-fg-1">
      Your new API key
    </h2>
    <p class="mt-2 text-sm font-medium text-err">This secret won't be shown again. Copy it now.</p>

    <div class="mt-4 flex items-center gap-2 rounded-md bg-sunken p-3">
      <code id="secret-value" class="flex-1 break-all font-mono text-sm text-fg-1"></code>
      <button
        type="button"
        class="btn-copy-secret shrink-0 rounded-md p-1.5 text-fg-3 transition-colors hover:bg-canvas hover:text-fg-1"
        aria-label="Copy secret key"
      >
        <Icon svg={copy} size={16} />
      </button>
    </div>
    <p id="secret-copied" class="mt-1 hidden text-xs text-ok">Copied to clipboard</p>

    <div class="mt-6 flex justify-end">
      <Button variant="primary" id="btn-close-secret">I've saved it</Button>
    </div>
  </div>
</dialog>

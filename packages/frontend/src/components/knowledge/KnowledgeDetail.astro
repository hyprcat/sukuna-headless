---
import KnowledgeOverview from './KnowledgeOverview.astro';
import KnowledgeEditForm from './KnowledgeEditForm.astro';

interface Props {
  canWrite: boolean;
}

const { canWrite } = Astro.props;
---

<div class="detail-panel" id="kb-detail-panel" hidden>
  <div class="detail-header">
    <div class="detail-title-row">
      <h2 id="detail-name" class="detail-name"></h2>
      <span id="detail-kind-badge" class="kind-badge"></span>
      <span id="detail-status-badge" class="status-badge"></span>
    </div>
  </div>

  <div class="detail-tabs" role="tablist" aria-label="Knowledge detail tabs">
    <button
      type="button"
      role="tab"
      id="tab-btn-overview"
      aria-selected="true"
      aria-controls="tab-overview"
      class="detail-tab detail-tab-active"
      data-tab="overview">Overview</button
    >
    {
      canWrite && (
        <button
          type="button"
          role="tab"
          id="tab-btn-edit"
          aria-selected="false"
          aria-controls="tab-edit"
          class="detail-tab"
          data-tab="edit"
        >
          Edit
        </button>
      )
    }
  </div>

  <KnowledgeOverview canWrite={canWrite} />
  {canWrite && <KnowledgeEditForm />}
</div>

<style>
  .detail-panel {
    border: 1px solid var(--ms-border-subtle);
    border-radius: var(--ms-r-md);
    background: var(--ms-bg-canvas);
    padding: var(--ms-space-5);
  }

  .detail-header {
    margin-bottom: var(--ms-space-4);
  }

  .detail-title-row {
    display: flex;
    align-items: center;
    gap: var(--ms-space-3);
    flex-wrap: wrap;
  }

  .detail-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ms-fg-1);
  }

  .kind-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--ms-r-pill);
    background: var(--ms-bg-sunken);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ms-fg-2);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--ms-r-pill);
    font-size: 0.75rem;
    font-weight: 500;
  }

  :global(.status-badge.active) {
    background: var(--ms-accent);
    color: var(--ms-accent-ink);
  }

  :global(.status-badge.inactive) {
    background: var(--ms-bg-sunken);
    color: var(--ms-fg-3);
  }

  .detail-tabs {
    display: flex;
    gap: var(--ms-space-1);
    border-bottom: 1px solid var(--ms-border-subtle);
    margin-bottom: var(--ms-space-4);
  }

  .detail-tab {
    padding: var(--ms-space-2) var(--ms-space-3);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ms-fg-3);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color var(--ms-t-color) var(--ms-ease-out);
    margin-bottom: -1px;
  }

  .detail-tab:hover {
    color: var(--ms-fg-1);
  }

  .detail-tab-active {
    color: var(--ms-fg-1);
    font-weight: 600;
    border-bottom-color: var(--ms-accent);
  }
</style>

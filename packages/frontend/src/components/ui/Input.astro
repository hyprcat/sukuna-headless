---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'password' | 'search' | 'url';
  placeholder?: string;
  required?: boolean;
  autocomplete?: string;
  hint?: string;
  value?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  placeholder,
  required = false,
  autocomplete,
  hint,
  value,
} = Astro.props;
---

<div class="flex flex-col gap-2">
  <label for={id} class="text-sm font-medium text-fg-1">
    {label}
  </label>
  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    required={required}
    autocomplete={autocomplete}
    value={value}
    aria-describedby={hint ? `${id}-hint` : undefined}
    class="input"
  />
  {
    hint && (
      <p id={`${id}-hint`} class="text-xs text-fg-3">
        {hint}
      </p>
    )
  }
</div>

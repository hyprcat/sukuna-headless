---
type Status = 'active' | 'inactive' | 'paused' | 'disabled';

interface Props {
  status: Status;
  class?: string;
}

const { status, class: cls = '', ...rest } = Astro.props;

const labels: Record<Status, string> = {
  active: 'Active',
  inactive: 'Inactive',
  paused: 'Paused',
  disabled: 'Disabled',
};

const isActive = status === 'active';
---

<span
  {...rest}
  data-status={status}
  class:list={['status-badge', isActive ? 'status-active' : 'status-muted', cls]}
>
  {labels[status]}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--ms-r-pill);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }

  .status-active {
    background: var(--ms-accent);
    color: var(--ms-accent-ink);
  }

  .status-muted {
    background: var(--ms-bg-sunken);
    color: var(--ms-fg-2);
  }
</style>

---
interface Props {
  svg: string;
  size?: number;
  class?: string;
  label?: string;
}

const { svg, size = 18, class: cls = '', label } = Astro.props;
const sized = svg
  .replace(/width="[^"]*"/, `width="${size}"`)
  .replace(/height="[^"]*"/, `height="${size}"`);
---

<span
  class={`inline-flex shrink-0 ${cls}`}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={sized}
/>

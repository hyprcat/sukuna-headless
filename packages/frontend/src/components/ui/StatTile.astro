---
interface Props {
  label: string;
  sublabel?: string;
  class?: string;
  [key: string]: unknown;
}

const { label, sublabel, class: cls = '', ...rest } = Astro.props;
const hasIcon = Astro.slots.has('icon');
---

<div class={`stat-tile ${cls}`} {...rest}>
  <div class={`stat-tile-inner ${hasIcon ? 'stat-tile-with-icon' : ''}`}>
    {
      hasIcon && (
        <span class="stat-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )
    }
    <p class="stat-value">
      <slot />
    </p>
    <p class="stat-label">{label}</p>
    {sublabel && <p class="stat-sublabel">{sublabel}</p>}
  </div>
</div>

<style>
  .stat-tile {
    min-width: 0;
  }

  .stat-tile-inner {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 2px;
  }

  .stat-tile-with-icon {
    gap: var(--ms-space-1);
  }

  .stat-icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    align-items: center;
    justify-content: center;
    color: var(--ms-fg-3);
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.05;
    color: var(--ms-fg-1);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .stat-label {
    font-size: 0.75rem;
    line-height: 1.25;
    color: var(--ms-fg-2);
  }

  .stat-sublabel {
    font-size: 0.75rem;
    line-height: 1.25;
    color: var(--ms-fg-2);
  }

  @media (min-width: 640px) {
    .stat-value {
      font-size: 1.875rem;
    }
  }
</style>

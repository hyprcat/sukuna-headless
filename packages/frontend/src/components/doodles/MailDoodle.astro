  fill="none"
  stroke="#111"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
>
  <rect x="36" y="62" width="128" height="84" rx="6"></rect>
  <path d="M36 68 L 100 116 L 164 68"></path>
  <path d="M36 140 L 78 108"></path>
  <path d="M164 140 L 122 108"></path>
</svg>

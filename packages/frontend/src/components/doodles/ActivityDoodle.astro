  <circle cx="14" cy="50" r="2.5" fill="#111" stroke="none"></circle>
  <circle cx="86" cy="50" r="2.5" fill="#111" stroke="none"></circle>
  <path d="M30 22 L 30 16"></path>
  <path d="M42 22 L 42 18"></path>
  <path d="M56 22 L 56 14"></path>
  <path d="M68 22 L 68 18"></path>
</svg>

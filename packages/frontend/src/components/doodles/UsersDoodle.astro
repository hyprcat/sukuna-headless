---
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: cls = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke="#111"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
>
  <!-- left person head -->
  <circle cx="36" cy="30" r="10"></circle>
  <!-- left person body/shoulders -->
  <path d="M20 62 Q 20 48, 36 46 Q 52 48, 52 62"></path>
  <!-- right person head (slightly offset for hand-drawn feel) -->
  <circle cx="65" cy="28" r="9"></circle>
  <!-- right person body/shoulders -->
  <path d="M51 58 Q 51 44, 65 42 Q 79 44, 79 58"></path>
  <!-- connection line between them (subtle) -->
  <path d="M46 50 Q 52 47, 55 50" stroke-width="1.2"></path>
</svg>

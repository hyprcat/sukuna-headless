---
import DataTable from '../ui/DataTable.astro';
import { timeAgo } from '../../lib/format';

interface Member {
  id: string;
  role: string;
  userEmail: string;
  userName: string;
  userId: string;
  joinedAt: string | null;
  userLastActiveAt: string | null;
}

interface Props {
  members: Member[];
  ownerId: string;
  canManage: boolean;
}

const { members, ownerId, canManage } = Astro.props;

function initials(name: string): string {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

const roleBg: Record<string, string> = {
  admin: 'bg-accent/20 text-fg-1',
  editor: 'bg-sunken text-fg-2',
  viewer: 'bg-sunken text-fg-2',
};
---

<DataTable label="Workspace members">
  <tr slot="head">
    <th>Members</th>
    <th>Role</th>
    <th class="hidden sm:table-cell">Last active</th>
    {canManage && <th>Actions</th>}
  </tr>
  {
    members.map((m) => (
      <tr>
        <td data-label="Member">
          <div class="flex items-center gap-3">
            <div class="grid h-9 w-9 shrink-0 place-items-center rounded-pill bg-sunken text-xs font-medium text-fg-2">
              {initials(m.userName)}
            </div>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-fg-1">
                {m.userName}
                {m.userId === ownerId && (
                  <span class="ml-1 text-xs font-normal text-fg-2">(owner)</span>
                )}
              </p>
              <p class="mt-0.5 truncate text-xs text-fg-2">{m.userEmail}</p>
            </div>
          </div>
        </td>
        <td data-label="Role">
          <span
            class={`inline-flex rounded-pill px-2.5 py-0.5 text-xs font-medium capitalize ${roleBg[m.role] ?? 'bg-sunken text-fg-2'}`}
          >
            {m.role}
          </span>
        </td>
        <td data-label="Last active" class="hidden text-xs text-fg-2 sm:table-cell">
          {m.userLastActiveAt ? timeAgo(m.userLastActiveAt) : 'Never'}
        </td>
        {canManage && (
          <td data-label="Actions" class="text-right">
            {m.userId !== ownerId ? (
              <div class="flex items-center justify-end gap-3">
                <select
                  class="role-select input !w-auto !border-0 !bg-transparent !py-0 !text-xs !text-fg-2"
                  data-member-id={m.id}
                  data-current-role={m.role}
                  aria-label={`Change role for ${m.userName}`}
                >
                  <option value="admin" selected={m.role === 'admin'}>
                    Admin
                  </option>
                  <option value="editor" selected={m.role === 'editor'}>
                    Editor
                  </option>
                  <option value="viewer" selected={m.role === 'viewer'}>
                    Viewer
                  </option>
                </select>
                <button
                  type="button"
                  class="btn-remove text-xs text-err/70 transition-colors hover:text-err"
                  data-member-id={m.id}
                  data-member-name={m.userName}
                  aria-label={`Remove ${m.userName} from workspace`}
                >
                  Remove
                </button>
              </div>
            ) : (
              <span class="text-xs text-fg-2">-</span>
            )}
          </td>
        )}
      </tr>
    ))
  }
</DataTable>

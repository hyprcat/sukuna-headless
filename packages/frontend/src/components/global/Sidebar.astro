---
import AgentSelector from './AgentSelector.astro';
import AccountMenu from './AccountMenu.astro';
import Icon from '../ui/Icon.astro';
import settingsIcon from 'lucide-static/icons/settings.svg?raw';
import type { Workspace } from '../../lib/types';

interface Props {
  current: string;
  settingsSub?: string;
  agentName?: string;
  agents?: Array<{ id: string; name: string }>;
  credits?: string;
  userCount?: string;
  userName?: string;
  userEmail?: string;
  workspaces?: Workspace[];
  currentWorkspaceSlug?: string | null;
  layout?: 'classic' | 'new';
}

const {
  current,
  settingsSub,
  agentName,
  agents,
  credits = '$0',
  userCount = '0',
  userName,
  userEmail,
  workspaces,
  currentWorkspaceSlug,
  layout = 'classic',
} = Astro.props;

const MAIN_TABS = [
  { id: 'overview', label: 'Overview', href: '/dashboard' },
  { id: 'runs', label: 'Runs', href: '/runs' },
  { id: 'tools', label: 'Tools', href: '/tools' },
  { id: 'knowledge', label: 'Knowledge', href: '/knowledge' },
  { id: 'schedules', label: 'Schedules', href: '/schedules' },
  { id: 'policies', label: 'Policies', href: '/policies' },
  { id: 'end-users', label: 'End Users', href: '/end-users' },
  { id: 'insights', label: 'Insights', href: '/insights' },
] as const;

const SETTINGS_TABS = [
  { id: 'workspace', label: 'Workspace', href: '/settings' },
  { id: 'members', label: 'Members', href: '/workspace/members' },
  { id: 'billing', label: 'Billing', href: '/billing' },
  { id: 'keys', label: 'API Keys', href: '/keys' },
  { id: 'integrations', label: 'Integrations', href: '/settings/integrations' },
  { id: 'danger', label: 'Danger zone', href: '/settings/danger' },
] as const;

const activeSettingsSub = settingsSub ?? 'workspace';
// New layout drops the Insights surface entirely.
const navTabs = layout === 'new' ? MAIN_TABS.filter((tab) => tab.id !== 'insights') : MAIN_TABS;
---

<aside
  class="hidden border-r border-border-subtle bg-canvas lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-64 lg:shrink-0 lg:flex-col"
  aria-label="Sidebar"
>
  <div class="px-4 py-5">
    <a
      href="/dashboard"
      class="text-[22px] font-semibold leading-none tracking-tight text-fg-1 motion-safe:transition-colors motion-safe:duration-150 hover:text-fg-2"
      aria-label="Go to dashboard"
    >
      midsphere.
    </a>
  </div>

  <div class="px-3 pb-3">
    <AgentSelector agentName={agentName} agents={agents} />
  </div>

  <nav aria-label="Main navigation" class="flex-1 overflow-y-auto px-2 pb-4">
    {
      navTabs.map((tab) => {
        const isActive = tab.id === current;
        return (
          <a
            href={tab.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'flex items-center border-l-2 px-3 py-2 text-sm motion-safe:transition-colors motion-safe:duration-150',
              isActive
                ? 'border-accent bg-sunken font-bold text-fg-1'
                : 'border-transparent text-fg-2 hover:bg-sunken hover:text-fg-1',
            ]}
          >
            {tab.label}
          </a>
        );
      })
    }

    {
      current === 'settings' && (
        <div class="mt-3 border-t border-border-subtle pt-3">
          <p class="px-3 pb-1 text-xs font-semibold tracking-wide text-fg-3 uppercase">Settings</p>
          {SETTINGS_TABS.map((sub) => {
            const isSubActive = sub.id === activeSettingsSub;
            return (
              <a
                href={sub.href}
                aria-current={isSubActive ? 'page' : undefined}
                class:list={[
                  'flex items-center border-l-2 px-3 py-2 text-sm motion-safe:transition-colors motion-safe:duration-150',
                  isSubActive
                    ? 'border-accent bg-sunken font-bold text-fg-1'
                    : 'border-transparent text-fg-2 hover:bg-sunken hover:text-fg-1',
                ]}
              >
                {sub.label}
              </a>
            );
          })}
        </div>
      )
    }
  </nav>

  <div class="border-t border-border-subtle px-3 py-4">
    <div
      class="flex items-center gap-3 rounded-lg bg-sunken px-3 py-2 text-sm font-medium text-fg-1"
    >
      <span>{credits} credits</span>
      <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      <span>{userCount} users</span>
    </div>

    <div class="mt-3 flex items-center gap-3 px-1">
      <AccountMenu
        userName={userName}
        workspaces={workspaces}
        currentWorkspaceSlug={currentWorkspaceSlug}
        layout={layout}
        placement="top-left"
      />
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium text-fg-1">{userName}</p>
        {
          userEmail && userEmail !== userName && (
            <p class="truncate text-xs text-fg-2">{userEmail}</p>
          )
        }
      </div>
      <a
        href="/settings"
        data-settings-trigger
        aria-current={current === 'settings' ? 'page' : undefined}
        aria-label="Settings"
        class:list={[
          'grid h-9 w-9 shrink-0 place-items-center rounded-lg motion-safe:transition-colors motion-safe:duration-150',
          current === 'settings'
            ? 'bg-sunken text-fg-1'
            : 'text-fg-2 hover:bg-sunken hover:text-fg-1',
        ]}
      >
        <Icon svg={settingsIcon} size={20} />
      </a>
    </div>
  </div>
</aside>

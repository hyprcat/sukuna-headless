---
import Button from '../ui/Button.astro';
import CodeBlock from '../ui/CodeBlock.astro';

interface Agent {
  id: string;
  name: string;
}

interface Props {
  agents: Agent[];
  canWrite?: boolean;
}

const { agents, canWrite = true } = Astro.props;
---

<form id="tool-editor-form" autocomplete="off">
  <input type="hidden" id="editor-tool-id" name="toolId" value="" />

  <div class="editor-field">
    <label for="editor-name" class="editor-label">Name</label>
    <input
      type="text"
      id="editor-name"
      name="name"
      class="input"
      placeholder="web_search"
      readonly={!canWrite}
    />
  </div>

  <div class="editor-field">
    <label for="editor-description" class="editor-label">Description</label>
    <input
      type="text"
      id="editor-description"
      name="description"
      class="input"
      placeholder="Search the web for up-to-date information."
      readonly={!canWrite}
    />
  </div>

  <div class="editor-field">
    <label for="editor-endpoint" class="editor-label">Endpoint</label>
    <input
      type="url"
      id="editor-endpoint"
      name="executionEndpoint"
      class="input"
      placeholder="https://api.example.com/v1/tool"
      readonly={!canWrite}
    />
  </div>

  <div class="editor-field">
    <label for="editor-schema" class="editor-label">Tool spec</label>
    <CodeBlock
      editable
      name="parametersSchema"
      textareaId="editor-schema"
      lang="json"
      label="JSON schema"
      rows={12}
      readonly={!canWrite}
    />
  </div>

  <div class="editor-field">
    <p id="agent-assignments-label" class="editor-label">Agent assignments</p>
    <div class="agent-list" role="group" aria-labelledby="agent-assignments-label">
      {
        agents.map((a) => (
          <span class="agent-assignment-badge" data-agent-name={a.name}>
            {a.name}
          </span>
        ))
      }
      {agents.length === 0 && <p class="text-xs text-fg-3">No agents in workspace.</p>}
    </div>
  </div>

  <div class="editor-field">
    <label class="flex items-center gap-2 text-sm text-fg-1">
      <input
        type="checkbox"
        id="editor-sensitive"
        name="isSensitive"
        class="accent-[var(--ms-accent)]"
        disabled={!canWrite}
      />
      Sensitive tool — requires end-user approval
    </label>
  </div>

  {
    canWrite && (
      <div class="editor-actions">
        <div id="editor-feedback" class="editor-feedback" role="status" aria-live="polite" hidden />
        <Button variant="accent" type="submit" id="save-tool-btn">
          Save changes
        </Button>
      </div>
    )
  }
</form>

<style>
  .editor-field {
    margin-bottom: var(--ms-space-4);
  }

  .editor-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ms-fg-1);
    margin-bottom: var(--ms-space-2);
  }

  .agent-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ms-space-2);
  }

  .agent-assignment-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--ms-r-pill);
    background: var(--ms-bg-sunken);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ms-fg-2);
  }

  :global(.agent-assignment-badge.assigned) {
    background: var(--ms-accent-soft);
    color: var(--ms-accent-ink);
  }

  .editor-actions {
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-3);
    padding-top: var(--ms-space-3);
    border-top: 1px solid var(--ms-border-subtle);
  }

  .editor-feedback {
    font-size: 0.8125rem;
    padding: var(--ms-space-2) var(--ms-space-3);
    border-radius: var(--ms-r-xs);
  }

  :global(.editor-feedback.success) {
    background: color-mix(in oklch, var(--ms-ok) 12%, transparent);
    color: var(--ms-ok);
  }

  :global(.editor-feedback.error) {
    background: color-mix(in oklch, var(--ms-err) 12%, transparent);
    color: var(--ms-err);
  }
</style>

---
import InsightCategoryBreakdown from './InsightCategoryBreakdown.astro';
import StatTile from '../ui/StatTile.astro';
import Icon from '../ui/Icon.astro';
import lightbulb from 'lucide-static/icons/lightbulb.svg?raw';
import checkCircle from 'lucide-static/icons/circle-check.svg?raw';

interface CategoryCount {
  category: string;
  count: number;
}

interface Props {
  totalActive: number;
  totalPinned: number;
  totalDismissed: number;
  byCategory: CategoryCount[];
}

const { totalActive, totalPinned, totalDismissed, byCategory } = Astro.props;

const totalVisible = totalActive + totalPinned;
const totalAll = totalVisible + totalDismissed;
const actionedRate = totalAll > 0 ? Math.round((totalDismissed / totalAll) * 100) : 0;
---

<aside class="sidebar" aria-label="Insight stats">
  <h2 class="sidebar-title">Insight stats</h2>

  <div class="stat-row">
    <StatTile label="visible insights">
      <Icon svg={lightbulb} size={18} class="text-fg-3" slot="icon" />
      {totalVisible}
    </StatTile>
  </div>

  <div class="stat-row">
    <StatTile label="actioned rate">
      <Icon svg={checkCircle} size={18} class="text-fg-3" slot="icon" />
      {actionedRate}%
    </StatTile>
    <div class="actioned-bar" aria-hidden="true">
      <div class="actioned-fill" style={`width: ${actionedRate}%`}></div>
    </div>
  </div>

  <InsightCategoryBreakdown byCategory={byCategory} />

  <div class="sidebar-links">
    <a href="/insights?status=dismissed" class="sidebar-link">Dismiss patterns</a>
    <a href="/settings" class="sidebar-link">Adjust alerts</a>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-5);
  }

  .sidebar-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ms-fg-1);
  }

  .stat-row {
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-2);
  }

  .actioned-bar {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--ms-bg-sunken);
    overflow: hidden;
  }

  .actioned-fill {
    height: 100%;
    border-radius: 3px;
    background: var(--ms-accent);
    transition: width 0.3s var(--ms-ease-out);
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-2);
    padding-top: var(--ms-space-2);
    border-top: 1px solid var(--ms-border-subtle);
  }

  .sidebar-link {
    font-size: 0.8125rem;
    color: var(--ms-fg-2);
    text-decoration: none;
  }

  .sidebar-link:hover {
    color: var(--ms-fg-1);
    text-decoration: underline;
  }
</style>

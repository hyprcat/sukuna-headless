---
import { CATEGORY_LABELS, CATEGORY_CSS_COLORS } from '../../lib/insight-categories';

interface CategoryCount {
  category: string;
  count: number;
}

interface Props {
  byCategory: CategoryCount[];
}

const { byCategory } = Astro.props;
---

{
  byCategory.length > 0 && (
    <div class="category-breakdown">
      <h3 class="breakdown-heading">Category breakdown</h3>
      <ul class="breakdown-list">
        {byCategory.map((cat) => (
          <li class="breakdown-item">
            <span
              class="breakdown-dot"
              style={`background: ${CATEGORY_CSS_COLORS[cat.category] ?? 'var(--ms-fg-3)'}`}
            />
            <span class="breakdown-label">{CATEGORY_LABELS[cat.category] ?? cat.category}</span>
            <span class="breakdown-count">{cat.count}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .category-breakdown {
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-3);
  }

  .breakdown-heading {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ms-fg-3);
  }

  .breakdown-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ms-space-2);
  }

  .breakdown-item {
    display: flex;
    align-items: center;
    gap: var(--ms-space-2);
    font-size: 0.875rem;
    color: var(--ms-fg-2);
  }

  .breakdown-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .breakdown-label {
    flex: 1;
  }

  .breakdown-count {
    font-weight: 500;
    color: var(--ms-fg-1);
    font-variant-numeric: tabular-nums;
  }
</style>

# Copy to .env for local development.
# Read by config/runtime.py via pydantic-settings.

ENVIRONMENT=dev
DEBUG=true
SECRET_KEY=dev-only-do-not-use-in-prod-replace-me
ALLOWED_HOSTS=["localhost","127.0.0.1"]

DATABASE_URL=postgres://postgres:postgres@localhost:5432/sukuna
REDIS_URL=redis://localhost:6379/0

# Observability — leave unset locally; the integrations no-op without DSN/key.
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# DigitalOcean Spaces (S3-compatible). Leave USE_OBJECT_STORAGE=false in dev to
# stay on local filesystem. Flip to true and fill the rest for staging/prod.
USE_OBJECT_STORAGE=false
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
# Optional: a CDN/custom domain in front of the bucket (no scheme, no trailing slash).
SPACES_CDN_DOMAIN=

# Frontend origin, used in emails and redirects.
FRONTEND_URL=http://localhost:4321

# Dodo Payments (credit top-ups). Leave empty to run without checkout.
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
DODO_RETURN_URL=
DODO_CANCEL_URL=
DODO_CREDIT_PRODUCT_IDS={}

# E2B sandbox runtime.
E2B_API_KEY=
E2B_TEMPLATE_ID=exo-native-agent-sandbox
SANDBOX_SERVER_API_KEY=

# Crypto material. Generate each value once, see the root README.
FERNET_ENCRYPTION_KEY=
MIDSPHERE_MANIFEST_KEY_ID=local-manifest-key
MIDSPHERE_MANIFEST_PRIVATE_KEY=
MIDSPHERE_JWT_KEY_ID=local-jwt-key
MIDSPHERE_JWT_PRIVATE_KEY=

# Public URL the sandbox posts signed callbacks to. dev-up.sh sets it to a tunnel.
BACKEND_PUBLIC_URL=
# Wildcard domain that fronts sandboxes in production. Empty in local dev.
SANDBOX_DOMAIN=
